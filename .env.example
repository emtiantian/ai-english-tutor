# ────────────────────────────────────────────
# AI English Tutor — 统一环境变量模板
# 本地 dev:  cp .env.example .env  （放在仓库根）
# 部署:      复制到 ~/.ai-english-tutor/data/.env
# 同名 key 在 dev/deploy 含义一致，差异以注释标出
# 注释掉 (# 开头) 的行 = 走代码默认值，需要覆盖时打开即可
# ────────────────────────────────────────────

# ── 服务器 ──
PORT=3000
# dev 留空或 development；docker 运行时由 compose 强制设为 production
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
SSE_HEARTBEAT_INTERVAL=30000
# HTTPS 虚拟主机（nginx server_name）。HTTPS 启用时填 FQDN/IP；
# 留空 = _ 匹配所有。注意：HTTPS 需先在 ${AI_TUTOR_HOME}/data/certs/
# 下放好 fullchain.pem / privkey.pem（跑 scripts/init-host-dir.sh 让
# mkcert 自动生成），gateway 容器挂载后会自动启用 443。
# SERVER_NAME=

# ── 前端（Vite，VITE_* 前缀，构建期注入）──
# 角色展示 Provider: live2d | spine | rive | svg
#   rive = 轻量矢量状态机，需在 public/models/rive/ 放置 .riv 文件
VITE_CHARACTER_PROVIDER=live2d
# Rive 专用（仅 VITE_CHARACTER_PROVIDER=rive 时生效，可选）
#   VITE_RIVE_SRC           .riv 路径，默认 /models/rive/tutor.riv
#   VITE_RIVE_STATE_MACHINE 状态机名，默认 "State Machine 1"
# VITE_RIVE_SRC=/models/rive/tutor.riv
# VITE_RIVE_STATE_MACHINE=State Machine 1
# 后端 API 地址：
#   dev    → http://localhost:3000  （直连后端）或留空走 Vite proxy
#   deploy → 留空 = 同源（gateway 反代）
VITE_BACKEND_URL=

# ── LLM Provider: xiaomi | deepseek | mock ──
LLM_PROVIDER=xiaomi

# Xiaomi LLM (Token Plan 接入小米 MiMo)
XIAOMI_API_KEY=
# Token Plan: https://token-plan-{cn|sgp|ams}.xiaomimimo.com/v1
# Pay-as-you-go: https://api.xiaomimimo.com/v1
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5

# DeepSeek（备用，OpenAI 兼容协议）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── TTS Provider: browser | xiaomi | cosyvoice ──
# browser = 浏览器 SpeechSynthesis 输出（前端 ttsSource=local，后端不合成）
TTS_PROVIDER=browser

# 通用 TTS 参数（默认值见 config.ts，按需开启覆盖）
# TTS_VOICE=alloy
# TTS_FORMAT=mp3                # mp3 | opus | aac | flac | wav | pcm
# TTS_SPEED=1.0                 # 0.25 ~ 4.0

# Xiaomi MiMo TTS
XIAOMI_TTS_API_KEY=
# Token Plan: https://token-plan-{cn|sgp|ams}.xiaomimimo.com/v1
# Pay-as-you-go: https://api.xiaomimimo.com/v1
XIAOMI_TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# preset | voicedesign | voiceclone
# - preset:      固定预置音色（XIAOMI_TTS_VOICE），每次 100% 一致，不需要 voiceDesign
# - voicedesign: 每次用文字描述实时生成音色，同一描述可能产生细微差异
# - voiceclone:  推荐模式。首次使用某 voiceDesign 时自动调用 voicedesign 生成"参考音频样本"存盘，
#                后续直接从磁盘读取样本做音色克隆，同一 voiceDesign 音色 100% 一致
XIAOMI_TTS_MODE=voiceclone
XIAOMI_TTS_VOICE=Chloe
# voicedesign 模式下的英文音色描述（fallback，session 有 personality 时优先走人设）。默认慵懒御姐风。
# XIAOMI_TTS_VOICE_DESIGN=成熟知性的御姐，声线低沉磁性、略带沙哑，慵懒从容，语速偏慢，句尾带轻气声
# 中文翻译音色（默认台湾腔温柔女声，按需自定义）
# XIAOMI_TTS_ZH_VOICE_DESIGN=台湾腔温柔女声，语速适中，声音甜美温暖，像是一个亲切的台湾小姐姐在跟你说话
# voiceclone 模式下的静态 base64 音频样本（留空则使用自动标定：首次从 voiceDesign 生成参考样本）
# XIAOMI_TTS_VOICE_CLONE=

# CosyVoice（可选，需 GPU；用 docker-compose.cosyvoice.yml 叠加部署）
# 启动: docker compose -f docker-compose.yml -f docker-compose.cosyvoice.yml up -d cosyvoice
# COSYVOICE_BASE_URL=http://cosyvoice:50000
# COSYVOICE_SPK_ID=英文女                         # 英文女 | 英文男 | 中文女 | 中文男
# COSYVOICE_SPEED=0.9                             # 教学场景建议 0.9，正常 1.0
# COSYVOICE_SAMPLE_RATE=22050                     # PCM 采样率：300M-SFT=22050，CosyVoice2-0.5B=24000

# ── ASR Provider: browser | whisper | xiaomi ──
# browser = 浏览器 Web Speech API 识别（前端识别，零容器零 key）
ASR_PROVIDER=browser

# 通用 ASR 参数
# ASR_LANGUAGE=auto             # en | zh | auto
# MAX_AUDIO_SIZE_MB=10          # 浏览器上传音频上限

# Whisper.cpp（可选 ASR，需用 docker-compose.whisper.yml 叠加部署）
# 启动: docker compose -f docker-compose.yml -f docker-compose.whisper.yml up -d
#   dev    → http://localhost:8080
#   deploy → http://whisper:8080  （docker 内部网络）
WHISPER_BASE_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en.bin

# Xiaomi MiMo ASR（可选，云端 ASR；不填则 fallback 到 XIAOMI_API_KEY/XIAOMI_BASE_URL）
# XIAOMI_ASR_API_KEY=
# XIAOMI_ASR_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# XIAOMI_ASR_MODEL=mimo-v2.5-asr

# ── 数据目录 ──
# 容器内由 docker-compose 强制覆盖为 /app/data；
# dev 留空走默认 <repo>/.dev-data
# DATA_DIR=
# DB_PATH=
# CONFIG_DIR=
# TTS_CACHE_DIR=

# ── TTS 缓存 / 复用原句池 ──
# TTS 音频按 sha256(text+voiceDesign) 缓存为 .wav，命中即不再调用 TTS（省 token）。
# 命中率可通过 GET /api/tts/stats 实时查看。
# TTS_CACHE_MAX_MB=1024          # 缓存总大小上限(MB)，超出按 LRU 淘汰
# TTS_CACHE_MAX_FILES=5000       # 缓存文件数上限，超出按 LRU 淘汰
# 复用原句池：记录每个场景/难度/音色下 Luna 说过的英文原句，注入 prompt 让 LLM
# 在合适处逐字复用，从而 100% 命中 TTS 缓存。池子从真实对话生长，用得越多越省。
# LINE_POOL_DIR=                 # 默认 ${DATA_DIR}/line-pool
# LINE_POOL_MAX_LINES=200        # 每个分组保留的原句上限，超出淘汰低频句
# LINE_POOL_INJECT_LIMIT=30      # 每次注入 prompt 的原句条数
