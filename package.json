{
  "name": "ai-english-tutor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter tutor-app dev",
    "server": "pnpm --filter @ai-english-tutor/server dev",
    "gateway": "bash gateway/dev.sh",
    "local": "bash scripts/dev-local.sh",
    "setup": "bash scripts/setup.sh",
    "setup:set": "bash scripts/set-env-key.sh",
    "dev:clean": "bash scripts/kill-ports.sh",
    "build": "pnpm --filter tutor-app build",
    "push:server": "bash scripts/deploy-to-server.sh",
    "push:server:generic": "bash scripts/deploy.sh",
    "verify:cosyvoice": "pnpm --filter @ai-english-tutor/server exec tsx ../../scripts/verify-cosyvoice.mts",
    "build:cosyvoice-spk2info": "pnpm --filter @ai-english-tutor/server exec tsx ../../scripts/build-cosyvoice-spk2info.mts"
  },
  "packageManager": "pnpm@10.7.1"
}
