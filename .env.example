# AI English Tutor environment template
# Local: cp .env.example .env
# Deploy: copy to ~/.ai-english-tutor/data/.env or run pnpm setup

PORT=3000
LOG_LEVEL=info
# 内容诊断日志：默认开启，单独文件默认 20MB 后轮转
LOG_CONTENT_ENABLED=true
LOG_CONTENT_FILE_MAX_MB=20
LOG_CONTENT_MAX_FILES=5
LOG_CONTENT_MAX_CHARS=1000000
CORS_ORIGIN=*
SSE_HEARTBEAT_INTERVAL=30000

# Production uses DeepSeek. Mock is reserved for tests and local UI work.
LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Xiaomi is the server TTS; browser is the fallback when no key is configured.
TTS_PROVIDER=xiaomi
# XIAOMI_TTS_API_KEY=
# XIAOMI_TTS_BASE_URL=https://api.xiaomimimo.com/v1
# preset | voicedesign
# XIAOMI_TTS_MODE=preset
# XIAOMI_TTS_VOICE=Mia
# XIAOMI_TTS_VOICE_DESIGN=
# Dedicated voice for clickable speaking hints.
# XIAOMI_TTS_HINT_VOICE=Mia
# XIAOMI_TTS_HINT_VOICE_DESIGN=A clear, calm female English pronunciation coach. Speak slowly and distinctly.
# TTS_FORMAT=mp3
# TTS_SPEED=1

# The first release uses the browser Web Speech API. No server ASR key is needed.
ASR_PROVIDER=browser
# ASR_LANGUAGE=en-US

# Leave empty in production so the frontend uses same-origin /api routes through the gateway.
VITE_BACKEND_URL=
VITE_LIVE2D_MAX_DPR=2.0
VITE_LIVE2D_TARGET_FPS=60
# SERVER_NAME=

# DATA_DIR=/app/data
# CONFIG_DIR=/app/data
