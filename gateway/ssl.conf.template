# ── AI English Tutor - HTTPS server block (rendered by docker-entrypoint.sh) ──
# This file is only materialised to /etc/nginx/conf.d/ssl.conf when TLS
# certs are mounted at /etc/nginx/certs/{fullchain,privkey}.pem. When
# the certs are missing the entrypoint deletes this file so HTTPS is
# disabled gracefully (HTTP-only on :80).
#
# Env vars substituted at render time:
#   SERVER_NAME   - virtual host for the 443 listener
#
# BACKEND_URL / FRONTEND_URL are not re-substituted here;
# the main nginx.conf already defines the $backend_target /
# $frontend_target map variables, and we reuse
# them so proxy_pass stays compatible with nginx's variable-upstream
# requirement (resolver + map).
#
# location / CORS 配置抽到 gateway/locations.conf，与 HTTP server 共用。

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/locations.conf;
}
