# ────────────────────────────────────────────
# AI English Tutor — 统一环境变量模板
# 本地 dev:  cp .env.example .env  （仓库根）
# 部署:      复制到 ~/.ai-english-tutor/data/.env
# 注释掉的行 = 走代码默认值
# ────────────────────────────────────────────

# ── Provider 选择 ──  volcengine 火山引擎
LLM_PROVIDER=volcengine        # deepseek | volcengine | xiaomi | mock
TTS_PROVIDER=browser           # browser | volcengine | cosyvoice | xiaomi
ASR_PROVIDER=browser           # browser | volcengine | whisper | xiaomi

# ── 服务器 ──
PORT=3000
# docker 运行时由 compose 强制设为 production
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
SSE_HEARTBEAT_INTERVAL=30000
# HTTPS 虚拟主机（nginx server_name）；留空 = _ 匹配所有
# SERVER_NAME=

# ── 前端（Vite 构建期注入）──
VITE_CHARACTER_PROVIDER=live2d
# VITE_LIVE2D_MODEL_ID=hiyori
# VITE_RIVE_SRC=/models/rive/tutor.riv
# VITE_RIVE_STATE_MACHINE="State Machine 1"
# dev → http://localhost:3000；deploy → 留空走 gateway 同源
VITE_BACKEND_URL=

# ── DeepSeek 官方 ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 火山方舟 LLM（OpenAI 兼容）──
VOLCENGINE_LLM_API_KEY=        # （必填）火山方舟 API Key
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_MODEL=          # 推理接入点 ID，如 ep-xxxxxxxxxxxxx

# 火山方舟 Agent Plan 语音合成 TTS
VOLCENGINE_TTS_API_KEY=        # （必填）不填则无法初始化 volcengine TTS
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
# VOLCENGINE_TTS_SPEAKER=zh_female_gaolengyujie_uranus_bigtts
# VOLCENGINE_TTS_FORMAT=mp3
# VOLCENGINE_TTS_SAMPLE_RATE=24000

# 火山方舟 Agent Plan 语音识别 ASR
# ASR key 不填则回退到 TTS key
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLCENGINE_ASR_BASE_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
# VOLCENGINE_ASR_SEGMENT_MS=200

# ── 小米（已停用，仅作字段参考）──
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# XIAOMI_MODEL=mimo-v2.5

# XIAOMI_TTS_API_KEY=
# XIAOMI_TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# voicedesign | voiceclone | preset
# XIAOMI_TTS_MODE=voicedesign
# XIAOMI_TTS_VOICE=Chloe
# XIAOMI_TTS_VOICE_CLONE=

# XIAOMI_ASR_API_KEY=
# XIAOMI_ASR_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# XIAOMI_ASR_MODEL=mimo-v2.5-asr

# ── 本地 / 浏览器 ──
# browser 作为 TTS/ASR 时无需后端 key，由前端 Web Speech API 处理

# CosyVoice（需 GPU + docker-compose.cosyvoice.yml）
# COSYVOICE_BASE_URL=http://cosyvoice:50000
# COSYVOICE_SPK_ID=英文女
# COSYVOICE_SPEED=0.9
# COSYVOICE_SAMPLE_RATE=22050

# Whisper.cpp（需 docker-compose.whisper.yml）
WHISPER_BASE_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en.bin

# ── 通用语音参数 ──
# TTS_FORMAT=mp3
# TTS_SPEED=1.0
# ASR_LANGUAGE=auto
# MAX_AUDIO_SIZE_MB=10

# ── 数据目录与缓存 ──
# 容器内由 docker-compose 强制覆盖为 /app/data；dev 留空走 <repo>/.dev-data
# DATA_DIR=
# DB_PATH=
# CONFIG_DIR=
# TTS_CACHE_DIR=
TTS_CACHE_MAX_MB=1024
TTS_CACHE_MAX_FILES=5000
# LINE_POOL_DIR=
# LINE_POOL_MAX_LINES=200
# LINE_POOL_INJECT_LIMIT=30
