# ────────────────────────────────────────────
# AI English Tutor — 统一环境变量模板
# 本地 dev:  cp .env.example .env  （仓库根）
# 部署:      pnpm setup            （生成交互式配置到 ~/.ai-english-tutor/data/.env）
#            或手动复制本文件到 ~/.ai-english-tutor/data/.env 后编辑
#
# 安全提示：
#   1. 本文件只应作为模板提交到仓库，不要把真实 API key 写进来。
#   2. 生成的 .env 已加入 .gitignore，请勿强制提交。
#   3. API key 丢失后通常需要到对应平台重新生成，无法从代码中恢复。
#
# 配置优先级（从高到低）：
#   进程环境变量 > docker-compose env_file > .env 文件 > config.ts 内置默认值
#
# 注释掉的行 = 走代码默认值
# ────────────────────────────────────────────

# ── Provider 选择 ──
# 必填。决定使用哪家 LLM / TTS / ASR 服务。
LLM_PROVIDER=mock              # deepseek | volcengine | xiaomi | openai | mock
TTS_PROVIDER=browser           # browser | volcengine | xiaomi | cosyvoice
ASR_PROVIDER=browser           # browser | volcengine | whisper | xiaomi

# ── 服务器 ──
# 容器内 HTTP 端口，一般无需修改。
PORT=3000
# docker 运行时由 Dockerfile 修改为 production；dev 可设为 development。
NODE_ENV=production
LOG_LEVEL=info                 # debug | info | warn | error
CORS_ORIGIN=*
SSE_HEARTBEAT_INTERVAL=30000
# HTTPS 虚拟主机（nginx server_name）；留空 = _ 匹配所有
# SERVER_NAME=

# ── 前端（Vite 构建期注入）──
# deploy 时留空，前端走 gateway 同源代理 /api/*
VITE_BACKEND_URL=
# Live2D 渲染缩放上限：1.0=最流畅，1.5=默认平衡，2.0=最清晰（Retina 屏可能卡顿）
VITE_LIVE2D_MAX_DPR=1.5
# Live2D 渲染目标帧率：30=低配流畅，60=默认平衡，120=不限帧（高刷屏可能更耗电）
VITE_LIVE2D_TARGET_FPS=60

# ── DeepSeek 官方 ──
# 当 LLM_PROVIDER 为 deepseek 时必填。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── OpenAI 官方 / 兼容网关 ──
# 当 LLM_PROVIDER 为 openai 时必填。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── 火山方舟 LLM（OpenAI 兼容）──
# 当 LLM_PROVIDER 为 volcengine 时必填。
# VOLCENGINE_LLM_API_KEY=        # （必填）火山方舟 API Key
# VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_LLM_MODEL=          # 推理接入点 ID，如 ep-xxxxxxxxxxxxx

# ── 小米 LLM（可选来源）──
# 当 LLM_PROVIDER 为 xiaomi 时必填。
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomi.com/v1
# XIAOMI_MODEL=milm-pro

# ── 火山方舟 Agent Plan 语音合成 TTS ──
# 当 TTS_PROVIDER 为 volcengine 时必填。
# VOLCENGINE_TTS_API_KEY=        # （必填）不填则无法初始化 volcengine TTS
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
# VOLCENGINE_TTS_SPEAKER=zh_female_gaolengyujie_uranus_bigtts
# VOLCENGINE_TTS_FORMAT=mp3
# VOLCENGINE_TTS_SAMPLE_RATE=24000

# ── 小米 TTS ──
# 当 TTS_PROVIDER 为 xiaomi 时必填。
# XIAOMI_TTS_API_KEY=
# XIAOMI_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# preset | voicedesign | voiceclone
# XIAOMI_TTS_MODE=preset
# XIAOMI_TTS_VOICE=Chloe
# voiceclone 模式参考音频 base64
# XIAOMI_TTS_VOICE_CLONE=
# voicedesign 模式英文兜底音色描述
# XIAOMI_TTS_VOICE_DESIGN=成熟知性的御姐，声线低沉磁性、略带沙哑，慵懒从容，语速偏慢，句尾带轻气声

# ── CosyVoice（需 GPU + docker-compose.cosyvoice.yml）──
# 当 TTS_PROVIDER 为 cosyvoice 时使用。
# COSYVOICE_BASE_URL=http://cosyvoice:50000
# CosyVoice2-0.5B 预置音色表仅含 EnglishTutor；自定义音色见项目文档。
# COSYVOICE_SPK_ID=EnglishTutor
# COSYVOICE_SPEED=0.9
# 采样率：CosyVoice2-0.5B 应设为 24000；CosyVoice 300M-SFT 用 22050。
# COSYVOICE_SAMPLE_RATE=24000
# 后端启动时异步探测 CosyVoice 服务是否存活，失败仅日志告警、不阻塞启动（设为 false 关闭）
# COSYVOICE_HEALTH_CHECK=true

# ── 火山方舟 Agent Plan 语音识别 ASR ──
# 当 ASR_PROVIDER 为 volcengine 时使用；ASR key 不填则回退到 TTS key。
# VOLCENGINE_ASR_API_KEY=
# VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLCENGINE_ASR_BASE_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
# VOLCENGINE_ASR_SEGMENT_MS=200

# ── 小米 ASR ──
# 当 ASR_PROVIDER 为 xiaomi 时使用；ASR key 不填则回退到 LLM key。
# XIAOMI_ASR_API_KEY=
# XIAOMI_ASR_BASE_URL=https://api.xiaomimimo.com/v1
# XIAOMI_ASR_MODEL=mimo-v2.5-asr

# ── Whisper.cpp（需 docker-compose.whisper.yml）──
# 当 ASR_PROVIDER 为 whisper 时使用。
WHISPER_BASE_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en.bin

# ── 通用语音参数 ──
# TTS_FORMAT=mp3
# TTS_SPEED=1.0
# ASR_LANGUAGE=auto
# MAX_AUDIO_SIZE_MB=10

# ── 数据目录与缓存 ──
# 容器内由 docker-compose 强制覆盖为 /app/data；dev 留空走 <repo>/.dev-data
# DATA_DIR=/app/data
# DB_PATH=/app/data/tutor.db
# CONFIG_DIR=/app/data
# TTS_CACHE_DIR=/app/data/tts-cache
TTS_CACHE_MAX_MB=1024
TTS_CACHE_MAX_FILES=5000
# LINE_POOL_DIR=/app/data/line-pool
# LINE_POOL_MAX_LINES=200
# LINE_POOL_INJECT_LIMIT=30
