# ────────────────────────────────────────────
# AI English Tutor — 统一环境变量模板
# 本地 dev:  cp .env.example .env  （仓库根）
# 部署:      复制到 ~/.ai-english-tutor/data/.env
# 注释掉的行 = 走代码默认值
# ────────────────────────────────────────────

# ── 服务器 ──
PORT=3000
# docker 运行时由 compose 强制设为 production
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
SSE_HEARTBEAT_INTERVAL=30000
# HTTPS 虚拟主机（nginx server_name）；留空 = _ 匹配所有
# SERVER_NAME=

# ── 前端（Vite 构建期注入）──
VITE_CHARACTER_PROVIDER=live2d
# VITE_LIVE2D_MODEL_ID=mao_pro
# VITE_RIVE_SRC=/models/rive/tutor.riv
# VITE_RIVE_STATE_MACHINE="State Machine 1"
# dev → http://localhost:3000；deploy → 留空走 gateway 同源
VITE_BACKEND_URL=

# ── LLM ──
# deepseek = 火山方舟 / DeepSeek 官方 OpenAI 兼容接口
# xiaomi   = 小米 MiMo（当前 key 已失效，仅留作示例）
LLM_PROVIDER=deepseek

# Xiaomi MiMo（已停用，留作参考）
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# XIAOMI_MODEL=mimo-v2.5

# DeepSeek（OpenAI 兼容）
# 火山方舟 Base URL: https://ark.cn-beijing.volces.com/api/v3
# 注意：DEEPSEEK_MODEL 必须填火山方舟「推理接入点 ID」（ep-xxxxxxxxxxxxx），不是 deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_MODEL=

# ── TTS ──
# browser    = 浏览器 SpeechSynthesis（前端输出，后端不合成）
# xiaomi     = MiMo TTS，支持 voicedesign/voiceclone/preset（当前 key 已失效）
# cosyvoice  = 本地 GPU 容器，需 docker-compose.cosyvoice.yml
# volcengine = 火山引擎语音合成大模型（纯 TTS，云 API）
TTS_PROVIDER=volcengine

# 通用 TTS 参数
# TTS_VOICE=alloy
# TTS_FORMAT=mp3
# TTS_SPEED=1.0

# Xiaomi TTS（已停用，留作参考）
# XIAOMI_TTS_API_KEY=
# XIAOMI_TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# voicedesign | voiceclone | preset
# XIAOMI_TTS_MODE=voiceclone
# XIAOMI_TTS_VOICE=Chloe
# XIAOMI_TTS_VOICE_DESIGN=成熟知性的御姐，声线低沉磁性、略带沙哑，慵懒从容，语速偏慢，句尾带轻气声
# XIAOMI_TTS_ZH_VOICE_DESIGN=台湾腔温柔女声，语速适中，声音甜美温暖，像是一个亲切的台湾小姐姐在跟你说话
# XIAOMI_TTS_VOICE_CLONE=

# CosyVoice（需 GPU + docker-compose.cosyvoice.yml）
# COSYVOICE_BASE_URL=http://cosyvoice:50000
# COSYVOICE_SPK_ID=英文女
# COSYVOICE_SPEED=0.9
# COSYVOICE_SAMPLE_RATE=22050

# Volcengine 火山引擎 TTS
# 音色由 voice_type 固定在服务端；前端「语音风格」仅作用于 LLM 人格
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE_TYPE=zh_female_gaolengyujie_moon_bigtts
VOLCENGINE_TTS_ENCODING=mp3
# 可选：指定模型版本 / ResourceId（如 seed-tts-2.0 或 doubao-seed-2.0-mini）
# VOLCENGINE_TTS_MODEL=
# VOLCENGINE_TTS_RESOURCE_ID=

# ── ASR ──
# browser = 浏览器 Web Speech API
# whisper = 本地容器，需 docker-compose.whisper.yml
# xiaomi  = 云端 ASR
ASR_PROVIDER=browser

# 通用 ASR 参数
# ASR_LANGUAGE=auto
# MAX_AUDIO_SIZE_MB=10

# Whisper.cpp
WHISPER_BASE_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en.bin

# Xiaomi ASR（不填则 fallback 到 LLM 的 key/url）
# XIAOMI_ASR_API_KEY=
# XIAOMI_ASR_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# XIAOMI_ASR_MODEL=mimo-v2.5-asr

# ── 数据目录 ──
# 容器内由 docker-compose 强制覆盖为 /app/data；dev 留空走 <repo>/.dev-data
# DATA_DIR=
# DB_PATH=
# CONFIG_DIR=
# TTS_CACHE_DIR=

# ── TTS 缓存 ──
TTS_CACHE_MAX_MB=1024
TTS_CACHE_MAX_FILES=5000
# LINE_POOL_DIR=
# LINE_POOL_MAX_LINES=200
# LINE_POOL_INJECT_LIMIT=30
