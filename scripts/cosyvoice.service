# ──────────────────────────────────────────────────────────────────────────
# 用途：开机自启 AI English Tutor CosyVoice TTS（顺带拉起整个 docker compose 栈）
#
# 安装：
#   sudo cp scripts/cosyvoice.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cosyvoice
#
# 卸载：
#   sudo systemctl disable --now cosyvoice
#   sudo rm /etc/systemd/system/cosyvoice.service
#   sudo systemctl daemon-reload
#
# 注意事项（与 deploy-to-server.sh 的关系）：
#   - systemd 负责开机自启：服务器重启后自动 docker compose up -d 拉起已有镜像。
#   - deploy-to-server.sh 负责代码更新后重启：rsync 新代码 -> up --build -d 重建镜像。
#   - 两者都调 docker compose up -d，幂等不冲突（up 是声明式：容器已存在则无操作）。
#   - 本 unit 不带 --build（开机自启只拉起已有镜像；构建由 deploy 脚本负责）。
#   - AI_TUTOR_HOME 通过 Environment= 注入，compose 文件中的 ${AI_TUTOR_HOME:-...}
#     可正常替换；backend 容器通过 env_file 读取 data/.env，不依赖 --env-file。
#   - 若部署根非默认路径（/home/haohe/data/.ai-english-tutor），需同步修改
#     WorkingDirectory / Environment / ExecStart 中的路径，或改用模板+环境生成。
# ──────────────────────────────────────────────────────────────────────────

[Unit]
Description=AI English Tutor CosyVoice TTS
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/haohe/data/.ai-english-tutor/app
Environment=AI_TUTOR_HOME=/home/haohe/data/.ai-english-tutor
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.cosyvoice.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.cosyvoice.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
