{
  "name": "@ai-english-tutor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/vocab/lists dist/vocab/",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "for f in $(find src -name '*.test.ts' | sort); do npx tsx \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@ai-english-tutor/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "lru-cache": "^11.5.1",
    "openai": "^4.77.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "~5.7.0"
  }
}
